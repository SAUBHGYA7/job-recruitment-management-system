# =====================================================================
# Job Recruitment Management System (JRMS) - Environment Template
# Copy this file to .env and configure strong, secret values.
# NEVER commit real credentials or .env to version control.
# =====================================================================

# Neo4j Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ReplaceWithStrongPassword123!
NEO4J_DATABASE=neo4j

# Backend Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=ReplaceWithSecureRandomJWTSecret123!

# Legacy Oracle Connection (Preserved for Reference During Migration)
ORACLE_USER=system
ORACLE_PASSWORD=ReplaceWithOraclePassword
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
