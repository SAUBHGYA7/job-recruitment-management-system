# Server Configuration
PORT=5000
NODE_ENV=development

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ReplaceWithStrongPassword123!
NEO4J_DATABASE=neo4j

# Security & Authentication
JWT_SECRET=ReplaceWithSecureRandomJWTSecret123!
JWT_EXPIRES_IN=8h

# Legacy Oracle Connection (Optional - preserved for reference)
ORACLE_USER=C##RECRUITMENT_DB
ORACLE_PASSWORD=YourPassword123
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=2
