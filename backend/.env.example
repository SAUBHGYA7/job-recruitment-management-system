# Server Configuration
PORT=5000
NODE_ENV=development

# Oracle Database Connection
# Connection String formats:
# 1. Easy Connect: host:port/service_name (e.g. localhost:1521/XEPDB1 or localhost:1521/XE or localhost:1521/FREEPDB1)
# 2. TNS Name (if tnsnames.ora configured)
ORACLE_USER=C##RECRUITMENT_DB
ORACLE_PASSWORD=YourPassword123
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=2

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_for_job_recruitment_system_2026
JWT_EXPIRES_IN=8h
